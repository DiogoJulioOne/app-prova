<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- discreet back control -->
        <ImageButton
            android:id="@+id/buttonVoltarPerfil"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_back_black_24"
                    app:tint="@color/texto_secundario"
            android:contentDescription="@string/voltar" />

        <!-- central header: avatar, name, nickname, bio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/imagemAvatarPerfil"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/bg_circle"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:contentDescription="Avatar"
                android:src="@drawable/avatar_1" />

            <TextView
                android:id="@+id/textoNomePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/texto"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoNicknamePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <!-- bio constrained width centered -->
            <TextView
                android:id="@+id/textoBioPerfil"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Sobre card with labeled fields -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sobre"
            android:textColor="@color/destaque"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_jogo"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="E-mail"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textoEmailPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto"
                android:textSize="15sp" />

            <View android:layout_width="match_parent" android:layout_height="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jogo favorito"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textoJogoFavoritoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/perfil_minha_biblioteca"
            android:textColor="@color/destaque"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                layout="@layout/item_estatistica_perfil"
                android:id="@+id/cardTotalJogos"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1" />

            <include
                layout="@layout/item_estatistica_perfil"
                android:id="@+id/cardJogando"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <include
                layout="@layout/item_estatistica_perfil"
                android:id="@+id/cardPausados"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1" />

            <include
                layout="@layout/item_estatistica_perfil"
                android:id="@+id/cardZerados"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />
        </LinearLayout>

        <include
            layout="@layout/item_estatistica_perfil"
            android:id="@+id/cardQueroJogar"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/textoPerfilVazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_jogo"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/perfil_biblioteca_vazia"
            android:textColor="@color/texto_secundario"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="@string/perfil_estatisticas"
            android:textColor="@color/destaque"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_jogo"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perfil_total_horas"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textoTotalHoras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/perfil_mais_jogado"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textoMaisJogado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoProgressoMedio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progressBarProgressoMedio"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="7dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/borda"
                android:progressTint="@color/destaque" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/perfil_jogos_concluidos"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textoJogosConcluidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonEditarPerfil"
            style="@style/BotaoSecundario"
            android:layout_marginTop="18dp"
            android:text="@string/editar_perfil" />

        <Button
            android:id="@+id/buttonSairPerfil"
            style="@style/BotaoPrincipal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:text="@string/sair_da_conta" />
    </LinearLayout>
</ScrollView>
