<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/marca_app"
            android:textColor="@color/destaque"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/titulo_login"
            android:textColor="@color/texto"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:text="@string/subtitulo_login"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/editNomeUsuario"
            style="@style/CampoTexto"
            android:hint="@string/nome_usuario"
            android:inputType="text"
            android:autofillHints="username" />

        <EditText
            android:id="@+id/editSenha"
            style="@style/CampoTexto"
            android:layout_marginTop="12dp"
            android:hint="@string/senha"
            android:inputType="textPassword"
            android:autofillHints="password" />

        <Button
            android:id="@+id/buttonEntrar"
            style="@style/BotaoPrincipal"
            android:layout_marginTop="24dp"
            android:text="@string/entrar" />

        <Button
            android:id="@+id/buttonIrCadastro"
            style="@style/BotaoSecundario"
            android:layout_marginTop="12dp"
            android:text="@string/ir_para_cadastro" />
    </LinearLayout>
</ScrollView>
