<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textoTituloDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card_jogo"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plataforma"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textoPlataformaDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/status"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textoStatusDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/destaque"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/data_inicio"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textoDataInicioDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/horas_jogadas"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textoHorasJogadasDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/textoProgressoDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progressBarJogo"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/destaque"
                android:progressBackgroundTint="@color/borda" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/observacoes"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textoObservacoesDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonEditarDetalhes"
            style="@style/BotaoPrincipal"
            android:layout_marginTop="24dp"
            android:text="@string/editar_jogo" />
    </LinearLayout>
</ScrollView>
