<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/voltar"
            android:scaleType="centerInside"
            android:src="@drawable/ic_voltar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/marca_app"
                android:textColor="@color/destaque"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/titulo_cadastro"
                android:textColor="@color/texto"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp"
                android:text="@string/subtitulo_cadastro"
                android:textColor="@color/texto_secundario"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/editNomeUsuario"
                style="@style/CampoTexto"
                android:hint="@string/nome_usuario"
                android:inputType="text"
                android:autofillHints="username" />

            <EditText
                android:id="@+id/editSenha"
                style="@style/CampoTexto"
                android:layout_marginTop="12dp"
                android:hint="@string/senha"
                android:inputType="textPassword"
                android:autofillHints="newPassword" />

            <EditText
                android:id="@+id/editConfirmarSenha"
                style="@style/CampoTexto"
                android:layout_marginTop="12dp"
                android:hint="@string/confirmar_senha"
                android:inputType="textPassword"
                android:autofillHints="newPassword" />

            <Button
                android:id="@+id/buttonCadastrar"
                style="@style/BotaoPrincipal"
                android:layout_marginTop="24dp"
                android:text="@string/cadastrar" />

            <TextView
                android:id="@+id/textJaTemConta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/ja_tem_conta_entrar"
                android:textColor="@color/destaque"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
