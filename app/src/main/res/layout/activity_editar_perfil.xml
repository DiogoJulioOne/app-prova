<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- small back button -->
        <ImageButton
            android:id="@+id/buttonCancelarEditar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back_black_24"
            android:contentDescription="@string/voltar"
            app:tint="@color/texto_secundario" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Editar perfil"
            android:textColor="@color/texto"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- large circular preview -->
        <ImageView
            android:id="@+id/imagemAvatarPreview"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_circle"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_real_1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Escolha um avatar"
            android:textColor="@color/texto_secundario" />

        <!-- grade de avatares -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- linha 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/avatar1"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_circle"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_real_1" />

                <ImageView
                    android:id="@+id/avatar2"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_circle"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_real_2" />

                <ImageView
                    android:id="@+id/avatar3"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_circle"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_real_3" />

            </LinearLayout>

            <!-- linha 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/avatar4"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_circle"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_real_4" />

                <ImageView
                    android:id="@+id/avatar5"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_circle"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_real_5" />

                <ImageView
                    android:id="@+id/avatar6"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_circle"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_real_6" />

            </LinearLayout>

            <!-- linha 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/avatar7"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_circle"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_real_7" />

                <ImageView
                    android:id="@+id/avatar8"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_circle"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_real_8" />

                <ImageView
                    android:id="@+id/avatar9"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_circle"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_real_9" />

            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/buttonEscolherFoto"
                style="@style/BotaoSecundario"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="🖼  Escolher foto da galeria" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Nome"
            android:textColor="@color/texto_secundario" />

        <EditText
            android:id="@+id/inputNome"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nickname"
            android:textColor="@color/texto_secundario" />

        <EditText
            android:id="@+id/inputNickname"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="E-mail"
            android:textColor="@color/texto_secundario" />

        <EditText
            android:id="@+id/inputEmail"
            style="@style/CampoTexto"
            android:inputType="textEmailAddress"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bio (max 150)"
            android:textColor="@color/texto_secundario" />

        <EditText
            android:id="@+id/inputBio"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="top"
            android:maxLines="6"
            android:inputType="textMultiLine" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Jogo favorito"
            android:textColor="@color/texto_secundario" />

        <AutoCompleteTextView
            android:id="@+id/inputJogoFavorito"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/buttonSalvarEditar"
                style="@style/BotaoPrincipal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/salvar" />

            <Button
                android:id="@+id/buttonCancelarFormulario"
                style="@style/BotaoSecundario"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/cancelar"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
